@model SchoolAppCoreMVC.Models.Course
@{ ViewData["Title"] = "Details Course"; }
<h1>Details Course</h1><table><tr><th>Title</th><td>@Model.Title</td></tr><tr><th>Credits</th><td>@Model.Credits</td></tr><tr><th>Department</th><td>@Model.Department?.DepartmentName</td></tr></table><br/><div class="actions"><a class="btn" asp-action="Edit" asp-route-id="@Model.CourseID">Edit</a><a class="btn secondary" asp-action="Index">Back</a></div>