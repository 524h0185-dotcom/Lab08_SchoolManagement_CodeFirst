@model IEnumerable<SchoolAppCoreMVC.Models.Course>
@{ ViewData["Title"] = "Courses"; }
<h1>Courses</h1><p><a class="btn" asp-action="Create">Create New</a></p><table><thead><tr><th>Title</th><th>Credits</th><th>Department</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) {<tr><td>@item.Title</td><td>@item.Credits</td><td>@item.Department?.DepartmentName</td><td class="actions"><a asp-action="Edit" asp-route-id="@item.CourseID">Edit</a><a asp-action="Details" asp-route-id="@item.CourseID">Details</a><a asp-action="Delete" asp-route-id="@item.CourseID">Delete</a></td></tr>}</tbody></table>
