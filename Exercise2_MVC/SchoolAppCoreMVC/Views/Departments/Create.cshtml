@model SchoolAppCoreMVC.Models.Department
@{ ViewData["Title"] = "Create Department"; }
<h1>Create Department</h1><form asp-action="Create" method="post"><label asp-for="DepartmentName">Department Name</label><input asp-for="DepartmentName" type="text" /><span asp-validation-for="DepartmentName"></span><label asp-for="Budget">Budget</label><input asp-for="Budget" type="number" step="0.01" /><span asp-validation-for="Budget"></span><label asp-for="StartDate">Start Date</label><input asp-for="StartDate" type="date" /><span asp-validation-for="StartDate"></span><div class="actions" style="margin-top:16px"><button type="submit">Save</button><a class="btn secondary" asp-action="Index">Back</a></div></form>