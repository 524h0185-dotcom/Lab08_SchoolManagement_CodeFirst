@model SchoolAppCoreMVC.Models.Enrollment
@{ ViewData["Title"] = "Delete Enrollment"; }
<h1>Delete Enrollment</h1><table><tr><th>Student</th><td>@Model.Student?.FirstName @Model.Student?.LastName</td></tr><tr><th>Course</th><td>@Model.Course?.Title</td></tr><tr><th>Grade</th><td>@Model.Grade</td></tr></table><br/><form asp-action="Delete" method="post"><input type="hidden" asp-for="EnrollmentID"/><button class="btn danger" type="submit">Delete</button> <a class="btn secondary" asp-action="Index">Cancel</a></form>