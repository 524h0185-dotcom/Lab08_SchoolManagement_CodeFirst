@model SchoolAppCoreMVC.Models.Student
@{ ViewData["Title"] = "Edit Student"; }
<h1>Edit Student</h1><form asp-action="Edit" method="post"><input type="hidden" asp-for="StudentID" /><label asp-for="FirstName">First Name</label><input asp-for="FirstName" type="text" /><span asp-validation-for="FirstName"></span><label asp-for="LastName">Last Name</label><input asp-for="LastName" type="text" /><span asp-validation-for="LastName"></span><label asp-for="EnrollmentDate">Enrollment Date</label><input asp-for="EnrollmentDate" type="date" /><span asp-validation-for="EnrollmentDate"></span><div class="actions" style="margin-top:16px"><button type="submit">Save</button><a class="btn secondary" asp-action="Index">Back</a></div></form>