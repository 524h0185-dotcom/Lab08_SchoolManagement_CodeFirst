@model SchoolAppCoreMVC.Models.Student
@{ ViewData["Title"] = "Details Student"; }
<h1>Details Student</h1><table><tr><th>First Name</th><td>@Model.FirstName</td></tr><tr><th>Last Name</th><td>@Model.LastName</td></tr><tr><th>Enrollment Date</th><td>@Model.EnrollmentDate</td></tr></table><br/><div class="actions"><a class="btn" asp-action="Edit" asp-route-id="@Model.StudentID">Edit</a><a class="btn secondary" asp-action="Index">Back</a></div>