@page
@model SchoolAppCoreRazor.Pages.Departments.CreateModel
@{ ViewData["Title"] = "Create Department"; }
<h1>Create Department</h1>
<form method="post">
<label asp-for="Item.DepartmentName">Department Name</label><input asp-for="Item.DepartmentName" type="text" /><span asp-validation-for="Item.DepartmentName"></span><label asp-for="Item.Budget">Budget</label><input asp-for="Item.Budget" type="number" step="0.01" /><span asp-validation-for="Item.Budget"></span><label asp-for="Item.StartDate">Start Date</label><input asp-for="Item.StartDate" type="date" /><span asp-validation-for="Item.StartDate"></span>
<div class="actions" style="margin-top:16px"><button type="submit">Save</button><a class="btn secondary" asp-page="Index">Back</a></div>
</form>