@page
@model SchoolAppCoreRazor.Pages.Enrollments.IndexModel
@{ ViewData["Title"] = "Enrollments"; }
<h1>Enrollments</h1><p><a class="btn" asp-page="Create">Create New</a></p>
<table><thead><tr><th>Student</th><th>Course</th><th>Grade</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model.Items) {<tr><td>@item.Student?.FirstName @item.Student?.LastName</td><td>@item.Course?.Title</td><td>@item.Grade</td><td class="actions"><a asp-page="Edit" asp-route-id="@item.EnrollmentID">Edit</a><a asp-page="Details" asp-route-id="@item.EnrollmentID">Details</a><a asp-page="Delete" asp-route-id="@item.EnrollmentID">Delete</a></td></tr>}
</tbody></table>
