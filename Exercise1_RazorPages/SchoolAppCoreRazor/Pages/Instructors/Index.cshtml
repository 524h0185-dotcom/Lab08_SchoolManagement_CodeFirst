@page
@model SchoolAppCoreRazor.Pages.Instructors.IndexModel
@{ ViewData["Title"] = "Instructors"; }
<h1>Instructors</h1>
<p><a class="btn" asp-page="Create">Create New</a></p>
<table><thead><tr><th>First Name</th><th>Last Name</th><th>Hire Date</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model.Items) {<tr><td>@item.FirstName</td><td>@item.LastName</td><td>@item.HireDate</td><td class="actions"><a asp-page="Edit" asp-route-id="@item.InstructorID">Edit</a><a asp-page="Details" asp-route-id="@item.InstructorID">Details</a><a asp-page="Delete" asp-route-id="@item.InstructorID">Delete</a></td></tr>}
</tbody></table>