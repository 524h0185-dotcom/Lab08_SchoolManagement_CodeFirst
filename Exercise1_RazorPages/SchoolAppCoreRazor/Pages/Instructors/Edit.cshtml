@page
@model SchoolAppCoreRazor.Pages.Instructors.EditModel
@{ ViewData["Title"] = "Edit Instructor"; }
<h1>Edit Instructor</h1>
<form method="post">
<input type="hidden" asp-for="Item.InstructorID" /><label asp-for="Item.FirstName">First Name</label><input asp-for="Item.FirstName" type="text" /><span asp-validation-for="Item.FirstName"></span><label asp-for="Item.LastName">Last Name</label><input asp-for="Item.LastName" type="text" /><span asp-validation-for="Item.LastName"></span><label asp-for="Item.HireDate">Hire Date</label><input asp-for="Item.HireDate" type="date" /><span asp-validation-for="Item.HireDate"></span>
<div class="actions" style="margin-top:16px"><button type="submit">Save</button><a class="btn secondary" asp-page="Index">Back</a></div>
</form>